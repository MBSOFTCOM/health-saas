<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.ppd.dal.mysql.screenpoint.ScreenPointMapper">


    <select id="selectByName"
            resultType="cn.iocoder.yudao.module.ppd.dal.dataobject.screenpoint.ScreenPointDO">
        SELECT id, name
        FROM tb_screen_point
        WHERE name = #{name}
          AND deleted = 0
    </select>


    <select id="getScreenPointList" resultType="java.lang.String">
        SELECT distinct name
        FROM tb_screen_point
        WHERE deleted = 0
    </select>


    <select id="getIdByName" resultType="java.lang.Long">
        SELECT id
        FROM tb_screen_point
        WHERE name = #{name} AND year = #{year} AND screen_dept = #{screenDept}
          AND deleted = 0
    </select>


    <select id="selectByIdTaskDeptId" resultType="java.lang.Long">
        SELECT dept_id
        FROM system_users
        WHERE id = #{loginUserId}
          AND deleted = 0
    </select>


    <select id="selectListByParentId"
            resultType="cn.iocoder.yudao.module.ppd.controller.admin.screenpoint.vo.DeptVO">
        SELECT id, name FROM system_dept
        <where>
            <foreach collection="parentIds" item="item" open="(" separator="or" close=")">
                parent_id = #{item}
            </foreach>
            AND deleted = 0
        </where>
    </select>


    <select id="getUserList"
            resultType="cn.iocoder.yudao.module.ppd.controller.admin.screenpoint.vo.UserVO">
        SELECT id, nickname FROM system_users
        <where>
            <foreach collection="deptIds" item="item" open="(" separator="or" close=")">
                dept_id = #{item}
            </foreach>
            AND deleted = 0
        </where>
    </select>


    <select id="getAllUserList"
            resultType="cn.iocoder.yudao.module.ppd.controller.admin.screenpoint.vo.UserVO">
        SELECT su.id, su.nickname, su.mobile, sd.name as deptName
        FROM system_users as su
                 INNER JOIN system_dept as sd ON su.dept_id = sd.id
        WHERE su.deleted = 0
          AND su.status = 0
    </select>


    <!--<update id="setPointBath">
        UPDATE system_users set screen_point_id = #{id}
        WHERE
        <foreach collection="userIds" item="item" open="(" separator="or" close=")">
            id = #{item}
        </foreach>
    </update>-->


    <select id="getCollectList" resultType="cn.iocoder.yudao.module.system.controller.admin.user.vo.user.UserRespVO">
        SELECT su.id, su.username, su.nickname, sd.name as deptName
        FROM system_users as su
        LEFT JOIN system_dept as sd ON sd.id = su.dept_id
        WHERE
        <foreach collection="collectList" item="item" open="(" separator="or" close=")">
            su.id = #{item}
        </foreach>
    </select>


</mapper>